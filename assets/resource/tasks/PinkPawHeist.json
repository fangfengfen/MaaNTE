{
    "task": [
        {
            "name": "粉爪大劫案",
            "entry": "PinkPawHeist_Main",
            "description": "自动刷取粉爪大劫案，需要桌面端-前台控制器。",
            "option": [
                "PinkPawHeist_Scheme",
                "PinkPawHeist_LoopInfinite"
            ],
            "controller": [
                "Win32-Front"
            ]
        }
    ],
    "option": {
        "PinkPawHeist_LoopCount": {
            "type": "input",
            "label": "循环次数",
            "description": "刷取粉爪大劫案的次数",
            "inputs": [
                {
                    "name": "count",
                    "default": "10",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "PinkPawHeist_CoreSequence": {
                    "max_hit": "{count}"
                }
            }
        },
        "PinkPawHeist_LoopInfinite": {
            "type": "switch",
            "label": "无限循环",
            "description": "启用后将无限循环刷取，直到手动停止(F11)。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "启用",
                    "pipeline_override": {
                        "PinkPawHeist_CoreSequence": {
                            "max_hit": 999999
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "禁用",
                    "option": [
                        "PinkPawHeist_LoopCount"
                    ]
                }
            ]
        },
        "PinkPawHeist_Scheme": {
            "type": "select",
            "label": "地图方案",
            "description": "选择本次战斗的地图移动方案。方案1需要配队：1娜娜莉3薄荷4早雾，需要一定练度，目前极不稳定。",
            "default_case": "Core1",
            "cases": [
                {
                    "name": "Core1",
                    "label": "方案一",
                    "pipeline_override": {
                        "PinkPawHeist_ExecuteScheme": {
                            "next": [
                                "PinkPawHeist_Scheme1"
                            ]
                        }
                    }
                }
            ]
        }
    }
}